# Supabase project URL and public anon key used by the browser client.
# The anon key is public; database access must be protected by the RLS policies
# in src/db/store-migration.sql. Never put a service-role key in this file.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
